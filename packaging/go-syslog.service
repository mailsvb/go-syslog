[Unit]
Description=go-syslog UDP syslog collector
Documentation=https://github.com/mailsvb/go-syslog
After=network.target

[Service]
Type=simple
User=gosyslog
Group=gosyslog
EnvironmentFile=-/etc/sysconfig/go-syslog
ExecStart=/usr/bin/go-syslog $GO_SYSLOG_ARGS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0027

# Bind to port 514 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. If you change -dir, add the new directory to ReadWritePaths
# with a drop-in: systemctl edit go-syslog
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/go-syslog
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
